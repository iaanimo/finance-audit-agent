# 财务报销审核受控 Agent —— 环境变量示例
#
# 复制成 .env 后填自己的值：  cp .env.example .env
#
# ⚠️ 两个 Key 都**不是必需的**：
#   不配叙事模型 Key -> 审核结论完全不受影响，审核意见退化为模板文字
#   不配视觉模型 Key -> PDF 文本层路径照常工作，只是扫描件/照片无法兜底

# ---- 叙事模型（只用于把规则结论翻译成人话，不参与任何判定）----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- 视觉模型（仅当 PDF 没有文本层、需要识别扫描件/照片时使用）----
# 通义千问 qwen-vl-max 的 DashScope 兼容模式地址
VISION_API_KEY=sk-your-key-here
